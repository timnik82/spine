# PostHog project settings — copy to .env.local and fill from
# https://us.posthog.com/settings/project (or your EU project settings).
# Leave unset locally to disable analytics.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Public Sentry DSN for client-side error reporting (safe to expose in the
# browser bundle). Leave unset to disable Sentry entirely.
VITE_SENTRY_DSN=

# Optional: upload hidden source maps during `npm run build`.
# Create an org auth token with Project:Read/Write and Release:Admin.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
